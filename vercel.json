{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/authorization", "destination": "/api" },
    { "source": "/account/(.*)", "destination": "/api" },
    { "source": "/download/(.*)", "destination": "/api" }
  ]
}
